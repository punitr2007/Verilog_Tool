+  c_capacity=3060
+  r_self_discharge=1M
+  a0_rs=0.07446
+  b0_rs=0.1562
+  b1_rs=24.37
+  a0_rts=0.04669
+  b0_rts=0.3208
+  b1_rts=29.14
+  a0_cts=703.6
+  b0_cts=-752.9
+  b1_cts=13.51
+  a0_rtl=0.04984
+  b0_rtl=6.603
+  b1_rtl=155.2
+  a0_ctl=4475
+  b0_ctl=-6056
+  b1_ctl=27.12
+  a0_vsrc=3.685
+  a1_vsrc=0.2156
+  a2_vsrc=-0.1178
+  a3_vsrc=0.3201
+  b0_vsrc=-1.031
+  b1_vsrc=35
+  soc_min=0.05
