+  ib=var_of_ib
+  ic=var_of_ic
+  e0_a=var_of_e0_a
+  e0_b=var_of_e0_b
+  e0_c=var_of_e0_c
+  theta_e=var_of_theta_e
+  tem=var_of_tem
outvar_dgtl:
outvar_ac:
callece bldc1
+  a=a b=b c=c
+  ia=ia ib=ib ic=ic
+  e_a=e_a e_b=e_b e_c=e_c
+  e0_a=e0_a e0_b=e0_b e0_c=e0_c
+  we=we wm=wm
+  tem=tem tl=tl
+  poles=poles
+  rs=rs ls=ls j=j ke=ke b_damp=b_damp
+  wm0=wm0
callgce intgrtr x=we y=theta_e y_sv=theta0
callgce modulo_twopi x=theta_e
callgce bldc_trz
+  theta=theta_e
+  e1=e0_a e2=e0_b e3=e0_c
callgce dummy x=wm
callgce dummy x=tl
callgce dummy x=ia
callgce dummy x=ib
callgce dummy x=ic
callgce dummy x=e_a
callgce dummy x=e_b
callgce dummy x=e_c
callgce dummy x=tem
endgme
