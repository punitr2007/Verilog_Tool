mainnodes_dgtl:
auxnodes_dgtl:
stparms_dgtl:
igparms_dgtl:
outvar_anlg:
+  soc=var_of_soc
+  IBatt=var_of_IBatt
outvar_dgtl:
outvar_ac:
  callece r name=r_discharge
+    p=p0 n=n r=r_self_discharge
  callece c name=c_discharge
+    p=p0 n=n c=c_capacity v0sv=v0_soc
  callece isrc_1 name=isrc
+    p=n n=p0 x=IBatt
  callece voltmeter_fb name=vm1
+    p=p0 m=n v_fb=soc
  callgce dummy x=IBatt
  callgce dummy x=soc
  callece battery_vsrc name=v_soc
+    p=a1 n=n soc=soc
+    a0=a0_vsrc
+    a1=a1_vsrc
+    a2=a2_vsrc
+    a3=a3_vsrc
+    b0=b0_vsrc
+    b1=b1_vsrc
  callece battery_r name=rs
+    p=a1 n=a2 soc=soc
+    a0=a0_rs
+    b0=b0_rs
+    b1=b1_rs
  callece battery_r name=rts
+    p=a2 n=a3 soc=soc
+    a0=a0_rts
+    b0=b0_rts
+    b1=b1_rts
  callece battery_r name=rtl
+    p=a3 n=a4 soc=soc
+    a0=a0_rtl
+    b0=b0_rtl
+    b1=b1_rtl
  callece battery_c name=cts
+    p=a2 n=a3 soc=soc
+    a0=a0_cts
+    b0=b0_cts
+    b1=b1_cts
  callece battery_c name=ctl
+    p=a3 n=a4 soc=soc
+    a0=a0_ctl
+    b0=b0_ctl
+    b1=b1_ctl
  callece ammeter_fb name=am1
+    p=a4 m=p i_fb=IBatt
endgme
gme name=bldc1 group=machines allow_ac=no
mainnodes_anlg: a b c
auxnodes_anlg:
