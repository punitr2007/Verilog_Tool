gme name=ic555a group=electronics allow_ac=no
mainnodes_anlg: ground trig out reset control thresh disch vcc
auxnodes_anlg: b
stparms_anlg:
igparms_anlg:
main_var:
aux_var:
iparms:
sparms:
rparms: v0=5 r=10k
rparms_derived:
mainnodes_dgtl:
auxnodes_dgtl: r1 s1 r s q qbar d0 d0bar
stparms_dgtl:
igparms_dgtl:
outvar_anlg:
outvar_dgtl:
+  r=dvar_of_r
+  s=dvar_of_s
+  q=dvar_of_q
+  qbar=dvar_of_qbar
outvar_ac:
callece r p=vcc     n=control r=r
callece r p=control n=b       r=r
callece r p=b       n=ground  r=r
calldce cmprtr1 vplus=thresh vminus=control d_out=r1
calldce cmprtr1 vplus=b      vminus=trig    d_out=s1
calldce rsff_nor r=r s=s q=q qbar=qbar
callece dac1a p=out n=ground d0=q vref=v0
callece switch_d p=disch n=ground d_in=qbar
calldce adc1 vin=reset d0=d0 vref=v0 dly=10n
calldce and_2 a1=d0 a2=s1 b=s dlyhl=10n dlylh=10n
calldce not a=d0 abar=d0bar dlyhl=10n dlylh=10n
calldce or_2  a1=d0bar a2=r1 b=r dlyhl=10n dlylh=10n
endgme
