ebe name=c startup_sprt=yes
Jacobian: constant
nodes: p n
ind_nodes:
ind_branches:
iparms:
sparms:
rparms:
+  c=1.0
+  v1=0
+  k_scale=1
local_var: qp qm
aux_var:
aux_var_startup: cur_p
digital_nodes:
main_var:
xvar:
stparms: v0sv=0
igparms:
no_functions=7
f_1: d_dt(qp)
f_2: d_dt(qm)
f_3: local_var qp v(p) v(n)
f_4: local_var qm v(p) v(n)
f_5: startup cur_p
f_6: startup cur_p
f_7: startup v(p) v(n)
C: compiled
endC
