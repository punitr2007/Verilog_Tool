title: indmc_v_by_f (V/f control of indmc)
# use this for the book
# The IM is connected to an inverter output. The pulses
# g1,g2,.. for the inverter are generated by calling gelement pwm_1.
greal g_high=1.0
greal ron=1m
greal roff=1M
greal vdc=615
greal cap=10n
greal rs=1.6068
greal delta_tmin=0.1u
greal delta_tnrml=10u
greal epsl=1.0e-6

begin_circuit
   eelement name=im1 type=indmc_mna
+    wrm=wrm tl=tl a=a b=b c=c
+    rs=rs lls=9.6m lm=241.9m llr=9.6m rr=1.6068
+    j=0.25 poles=4

   eelement type=voltmeter_fb_mna p=a m=0 v_fb=v_an
   eelement type=voltmeter_fb_mna p=b m=0 v_fb=v_bn
   eelement type=voltmeter_fb_mna p=c m=0 v_fb=v_cn

   eelement type=voltmeter_fb_mna p=a m=b v_fb=v_ab
   eelement type=voltmeter_fb_mna p=b m=c v_fb=v_bc
   eelement type=voltmeter_fb_mna p=c m=a v_fb=v_ca

   gelement type=dummy x=v_an
   gelement type=dummy x=v_bn
   gelement type=dummy x=v_cn

   gelement type=dummy x=v_ab
   gelement type=dummy x=v_bc
   gelement type=dummy x=v_ca

   gelement type=dummy x=wrm
   gelement type=const y=tl c=0

#  generate 0,120,-120 degrees (convert to rad.)

   gelement type=const y=phi1 c= 0
   gelement type=const y=phi2 c=-2.094395
   gelement type=const y=phi3 c= 2.094395

#  frequency command:
   gelement type=pwl20 y=f_star
+     n=4
+     t1=0.1    v1=0
+     t2=0.11   v2=1
+     t3=4.00   v3=1
+     t4=4.01   v4=0.5

#  make the frequency command smoother by calling lag_1
#
#  Book problem: change the tr parameter by +/- 20 % and see its effect.
#  The following three cases correspond to the files a,b,c in the
#  solve section

#  gelement type=lag_1 x=f_star y=f_star_1 tr=0.25
   gelement type=lag_1 x=f_star y=f_star_1 tr=0.02
#  gelement type=lag_1 x=f_star y=f_star_1 tr=0.30

#  generate v_star (normalized amplitude of the reference voltages
#  to be fed to the PWM block). On the low-frequency side, v_star
#  is capped to a minimum value.

   gelement type=pwl10_xy
+     x=f_star_1 y=v_star
+     n=2
+     x1=0.2  y1=0.2
+     x2=1.0  y2=1.0

#  multiply frequency by scaling factor:

   gelement type=multscl x=f_star_1 y=f a=50

#  multiply reference (command) frequency by scaling factor in order
#  to plot the two together.

   gelement type=multscl x=f_star y=f_star_2 a=50

#  generate omega from f, then theta, by integrating omega

   gelement type=multscl x=f a=6.28318 y=w
   gelement type=intgrtr x=w y=theta

#  generate the reference voltages for the PWM block:

   gelement type=sum_2 x1=theta x2=phi1 y=theta1
   gelement type=sum_2 x1=theta x2=phi2 y=theta2
   gelement type=sum_2 x1=theta x2=phi3 y=theta3

   gelement type=sine x=theta1 y=s1
   gelement type=sine x=theta2 y=s2
   gelement type=sine x=theta3 y=s3

   gelement type=mult_2 x1=v_star x2=s1 y=va
   gelement type=mult_2 x1=v_star x2=s2 y=vb
   gelement type=mult_2 x1=v_star x2=s3 y=vc

#  PWM block:

#   gelement type=pwm_2 name=pwm
#+    va=va vb=vb vc=vc
#+    g1=g1 g2=g2 g3=g3 g4=g4 g5=g5 g6=g6
#+    tperiod=500u
#+    t0=0
#+    triangle_high= 1.0
#+    triangle_low =-1.0
#+    epsl=1.0e-6
#+    g_high=g_high

   gelement type=pwm_1 name=pwm
+    va=va vb=vb vc=vc
+    g1=g1 g2=g2 g3=g3 g4=g4 g5=g5 g6=g6
+    tperiod=500u
+    t0=0
+    triangle_high= 1.0
+    triangle_low =-1.0
+    epsl=1.0e-6
+    delta_tmin=delta_tmin
+    delta_tnrml=delta_tnrml
+    g_high=g_high

#  inverter:

   eelement type=vsrcdc_mna p=p n=m vdc=vdc

#   eelement type=invrtr_a_mna name=invrtr
#+    a=a b=b c=c p=p m=m
#+    g1=g1 g2=g2 g3=g3 g4=g4 g5=g5 g6=g6
#+    ron=ron roff=roff
#+    g_high=g_high
#+    cap=1u

   eelement type=invrtr_mna name=invrtr
+    a=a b=b c=c p=p m=m
+    g1=g1 g2=g2 g3=g3 g4=g4 g5=g5 g6=g6
+    ron=ron roff=roff
+    g_high=g_high

#  These are required to define node voltages properly.
   eelement type=r_mna p=a n=0 r=1M
   eelement type=r_mna p=b n=0 r=1M
   eelement type=r_mna p=c n=0 r=1M

   refnode=0

   outvar:
+     f=var_of_f
+     va=var_of_va
+     vb=var_of_vb
+     vc=var_of_vc
+     v_a=nodev_of_a
+     v_b=nodev_of_b
+     v_c=nodev_of_c
+     wrm=var_of_wrm
+     tem=tem_of_im1
+     ia=ia_of_im1
+     ib=ib_of_im1
+     ic=ic_of_im1
+     g1=var_of_g1
+     g2=var_of_g2
+     g3=var_of_g3
+     g4=var_of_g4
+     g5=var_of_g5
+     g6=var_of_g6
+     f_star_2=var_of_f_star_2
+     v_an=var_of_v_an
+     v_bn=var_of_v_bn
+     v_cn=var_of_v_cn
+     v_ab=var_of_v_ab
+     v_bc=var_of_v_bc
+     v_ca=var_of_v_ca

#   output smat
end_circuit

begin_solve
   solve_type=startup
   initial_sol initialize
   method: t_startup=0
   method: write_rhs2=yes
   method: norm_2=1e-9
   method: itmax_newton=6
#  method: wrt_debug_smat=no iter_debug_newton=4
end_solve

# the following block is for debugging:
#begin_solve
   solve_type=trns
   initial_sol previous
   method: t_start=0 t_end=0.1

   method:
+     back_euler=yes
+     norm_2=1e-6 delt_const=delta_tnrml
+     n_wrtiterno=10000
end_solve

begin_solve
   solve_type=trns
   initial_sol previous
#  initial_sol initialize
   begin_output
#     filename=vbyf1_1a.dat limit_lines=500000
      filename=vbyf1_1b.dat limit_lines=500000
#     filename=vbyf1_1c.dat limit_lines=500000

      control: fixed_interval=100u
      variables: f_star_2 f wrm v_a
   end_output
   begin_output
#     filename=vbyf1_2a.dat limit_lines=500000
      filename=vbyf1_2b.dat limit_lines=500000
#     filename=vbyf1_2c.dat limit_lines=500000

      control: fixed_interval=100u
      variables: va vb vc ia ib ic tem
   end_output
   begin_output
#     filename=vbyf1_3a.dat limit_lines=500000
      filename=vbyf1_3b.dat limit_lines=500000
#     filename=vbyf1_3c.dat limit_lines=500000

      control: fixed_interval=100u
      variables: v_an v_bn v_cn v_ab v_bc v_ca
   end_output
   begin_output
#     filename=vbyf1_4a.dat limit_lines=1000000
      filename=vbyf1_4b.dat limit_lines=1000000
#     filename=vbyf1_4c.dat limit_lines=1000000

      variables: g1 g2 g3 g4 g5 g6
#     control: out_tstart=5.500 out_tend=5.501
      control: out_tstart=1.800 out_tend=1.801
   end_output

   method: t_start=0 t_end=2

   method:
+     itmax_trns=2000000
#     back_euler=yes
#     norm_2=1e-6 delt_const=delta_tnrml
+     trapezoidal=yes
+     norm_2=1e-6 delt_const=delta_tnrml
#     gear2=yes
#     norm_2=1e-6 delt_const=delta_tnrml
+     n_wrtiterno=10000
end_solve

end_cf
